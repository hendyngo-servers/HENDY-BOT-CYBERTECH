{
  "version": 1,
  "description": "Manifest môi trường runtime cho Hendy Bot Tele. Không lưu giá trị bí mật trong file này.",
  "variables": {
    "APP_ENV": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "production",
      "sync_to_render": true
    },
    "PORT": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "10000",
      "sync_to_render": true
    },
    "APP_URL": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "sync_to_render": true,
      "required_when": "WEBHOOK_AUTO_REGISTER=true"
    },
    "WEBAPP_URL": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true
    },
    "ALLOWED_ORIGINS": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true
    },
    "BOT1_TOKEN": {
      "classification": "secret",
      "required": true,
      "source": "github_secret",
      "sync_to_render": true
    },
    "BOT2_TOKEN": {
      "classification": "secret",
      "required": false,
      "source": "github_secret",
      "sync_to_render": true
    },
    "ADMIN_ID": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "sync_to_render": true
    },
    "BOT_USERNAME": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true
    },
    "DATABASE_URL": {
      "classification": "secret",
      "required": true,
      "source": "render_postgres",
      "managed_by": "Render PostgreSQL / Blueprint",
      "sync_to_render": false
    },
    "DATABASE_SSL": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "false",
      "sync_to_render": true
    },
    "DB_STARTUP_WAIT_SECONDS": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "120",
      "sync_to_render": true
    },
    "RUN_MIGRATIONS_ON_START": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "true",
      "sync_to_render": true
    },
    "TELEGRAM_WEBHOOK_SECRET": {
      "classification": "secret",
      "required": true,
      "source": "github_secret",
      "generated_if_missing": true,
      "sync_to_render": true,
      "required_when": "WEBHOOK_AUTO_REGISTER=true"
    },
    "TELEGRAM_SECOND_WEBHOOK_SECRET": {
      "classification": "secret",
      "required": false,
      "source": "github_secret",
      "generated_if_missing": true,
      "sync_to_render": true,
      "required_when": "BOT2_TOKEN is set and WEBHOOK_AUTO_REGISTER=true"
    },
    "BANK_WEBHOOK_SECRET": {
      "classification": "secret",
      "required": false,
      "source": "github_secret",
      "generated_if_missing": true,
      "sync_to_render": true
    },
    "WEBHOOK_AUTO_REGISTER": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "true",
      "sync_to_render": true
    },
    "VIETQR_BANK_ID": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true
    },
    "VIETQR_ACCOUNT_NO": {
      "classification": "secret",
      "required": false,
      "source": "github_secret",
      "sync_to_render": true
    },
    "VIETQR_ACCOUNT_NAME": {
      "classification": "secret",
      "required": false,
      "source": "github_secret",
      "sync_to_render": true
    },
    "GROUP_URL": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true
    },
    "CHANNEL_URL": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true
    },
    "TELEGRAM_INIT_DATA_MAX_AGE_SECONDS": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "86400",
      "sync_to_render": true
    },
    "LEGACY_SESSION_SECRET": {
      "classification": "secret",
      "required": false,
      "source": "github_secret",
      "generated_if_missing": true,
      "sync_to_render": true
    },
    "WEBSOCKET_URL": {
      "classification": "variable",
      "required": false,
      "source": "github_variable",
      "sync_to_render": true
    },
    "WEBSOCKET_BIND": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "0.0.0.0",
      "sync_to_render": true
    },
    "WEBSOCKET_PORT": {
      "classification": "variable",
      "required": true,
      "source": "github_variable",
      "default": "10000",
      "sync_to_render": true
    },
    "RENDER_EXTERNAL_URL": {
      "classification": "variable",
      "required": false,
      "source": "render_managed",
      "managed_by": "Render",
      "sync_to_render": false
    },
    "GH_TOKEN": {
      "classification": "secret",
      "required": false,
      "source": "github_environment_secret",
      "scope": "ci",
      "sync_to_render": false
    },
    "RENDER_API_KEY": {
      "classification": "secret",
      "required": false,
      "source": "github_environment_secret",
      "scope": "ci",
      "sync_to_render": false
    },
    "RENDER_SERVICE_ID": {
      "classification": "variable",
      "required": false,
      "source": "github_environment_variable",
      "scope": "ci",
      "sync_to_render": false
    },
    "TARGET_ENVIRONMENT": {
      "classification": "variable",
      "required": false,
      "source": "workflow_dispatch_input",
      "scope": "ci",
      "sync_to_render": false
    },
    "GITHUB_REPOSITORY": {
      "classification": "variable",
      "required": false,
      "source": "github_context",
      "scope": "ci",
      "sync_to_render": false
    },
    "GITHUB_SHA": {
      "classification": "variable",
      "required": false,
      "source": "github_context",
      "scope": "ci",
      "sync_to_render": false
    }
  }
}
