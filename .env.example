# ⚙️ HENDY BOT TELE — PHP 8.3
# Sao chép file này thành .env khi chạy local.
# CHỈ dùng placeholder trong file mẫu; không đưa token, mật khẩu hoặc secret thật vào Git.

APP_ENV=local
PORT=8000
APP_URL=
WEBAPP_URL=
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Telegram Bot tokens
BOT1_TOKEN=REPLACE_WITH_BOT_1_TOKEN
BOT2_TOKEN=
ADMIN_ID=REPLACE_WITH_TELEGRAM_NUMERIC_ADMIN_ID
BOT_USERNAME=

# PostgreSQL
DATABASE_URL=
DATABASE_SSL=true

# Webhook secrets — thay bằng chuỗi ngẫu nhiên độc lập
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_BOT_1_SECRET
TELEGRAM_SECOND_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_BOT_2_SECRET
BANK_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_BANK_SECRET

# VietQR configuration
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=

# Community links
GROUP_URL=
CHANNEL_URL=

# Telegram WebApp session validation
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# Optional one-time legacy login exchange
LEGACY_SESSION_SECRET=

# PHP Ratchet WebSocket (Render realtime service)
WEBSOCKET_URL=
WEBSOCKET_BIND=0.0.0.0
WEBSOCKET_PORT=10000
