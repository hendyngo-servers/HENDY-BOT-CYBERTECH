# ⚙️ CẤU HÌNH HỆ THỐNG BOT
# Sao chép thành .env để chạy local. Tuyệt đối không commit token/secret thật.

NODE_ENV=development
PORT=8000

# BOT CHÍNH (BOT 1)
# Tên chuẩn: BOTCHINH_TOKEN
# Bí danh tương thích: BOT1_TOKEN hoặc BOT_TOKEN
BOTCHINH_TOKEN=REPLACE_WITH_PRIMARY_TELEGRAM_BOT_TOKEN
ADMIN_ID=REPLACE_WITH_TELEGRAM_NUMERIC_ADMIN_ID

# BOT PHỤ (BOT 2) - không bắt buộc
# Tên chuẩn: BOTPHU_TOKEN
# Bí danh tương thích: BOT2_TOKEN hoặc BOT_SECOND_TOKEN
BOTPHU_TOKEN=
# Nếu để trống, bot phụ dùng chung ADMIN_ID
BOTPHU_ADMIN_ID=
BOT_SECOND_USERNAME=

# PostgreSQL
# Local dùng database URL của bạn; External URL của Render cần TLS.
# Render Blueprint sẽ tự kết nối DATABASE_URL qua PostgreSQL cùng region.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/hendy_bot_tele?sslmode=require
DATABASE_SSL=true
PGPOOL_MAX=10

# URL dịch vụ (Render tự cấp RENDER_EXTERNAL_URL khi deploy)
RENDER_EXTERNAL_URL=
WEBAPP_URL=
MINI_APP_URL=
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173

# Webhook secrets - tạo giá trị ngẫu nhiên riêng, không dùng lại token bot
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET
TELEGRAM_SECOND_WEBHOOK_SECRET=
BANK_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_BANK_WEBHOOK_SECRET

# Đăng nhập website cũ (không bắt buộc)
LEGACY_ACCOUNT_URL=
LEGACY_SESSION_SECRET=

# VietQR và liên kết cộng đồng
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
GROUP_URL=
CHANNEL_URL=
BOT_USERNAME=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
