APP_ENV=local
PORT=8000
APP_URL=
WEBAPP_URL=https://hendy-bot-tele.onrender.com
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Telegram Bot tokens — lấy token mới từ @BotFather
BOT1_TOKEN=9144036314:AAFH3GVefNaBItuip4FHQMjj9r85IxOHdHI
BOT2_TOKEN=8884608128:AAHV9bM8EtVqnO_S222I8IXcq2sYkDEZIyk
ADMIN_ID=8639286417
BOT_USERNAME=hendymono_bot
# PostgreSQL
# Render cùng workspace + region: dùng Internal Database URL.
# Local hoặc service khác region: dùng External Database URL với sslmode=require.
DATABASE_URL=postgresql://authenticator:npg_VKI4DHAYcN9r@ep-green-water-b3fjpxk7-pooler.c-4.ap-southeast-1.aws.neon.tech/hendy-bot-tele-db?sslmode=require&channel_binding=require
DATABASE_SSL=true

# Webhook secrets — mỗi biến phải là secret ngẫu nhiên RIÊNG
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_BOT_1_SECRET
TELEGRAM_SECOND_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_BOT_2_SECRET
BANK_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_BANK_SECRET
WEBHOOK_AUTO_REGISTER=true

# VietQR configuration
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
