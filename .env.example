CHANNEL_URL=

# Telegram WebApp session validation
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# Optional one-time legacy login exchange
LEGACY_SESSION_SECRET=

# PHP Ratchet WebSocket (Render realtime service)
WEBSOCKET_URL=https://hendy-bot-tele.onrender.com
WEBSOCKET_BIND=0.0.0.0
WEBSOCKET_PORT=10000
