# PostgreSQL — lấy đúng URL tại Connect của database đang chạy
# Render Internal URL chỉ dùng giữa các resource cùng region/workspace.
# External URL cần sslmode=require.
DATABASE_URL=postgresql://USER:REPLACE_WITH_PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_SSL=true
DB_STARTUP_WAIT_SECONDS=120
RUN_MIGRATIONS_ON_START=true

