# ⚙️ HENDY BOT TELE — PHP 8.3
# Sao chép thành .env khi chạy local.
# Trên Render, tạo từng biến tại Environment.
# Chỉ dùng placeholder trong file mẫu; KHÔNG commit token hoặc secret thật.

APP_ENV=production
PORT=10000
APP_URL=https://hendy-bot-cybertech.onrender.com
WEBAPP_URL=https://hendy-bot-cybertech.onrender.com
ALLOWED_ORIGINS=https://hendy-bot-cybertech.onrender.com

# Telegram — BOT1 là bot chính @HendyBot_Bot; BOT2 là bot thử nghiệm @hendymono_bot
BOT1_TOKEN=REPLACE_WITH_HENDYBOT_BOT_TOKEN
BOT2_TOKEN=9125467847:AAFcqid0vGYXOVAfHLORC16eqSkN3LQ-xZ4
# Telegram numeric user ID của tài khoản quản trị (chỉ chữ số, không dấu nháy)
ADMIN_ID=6138197737
# Có thể thêm nhiều admin ID, phân tách bằng dấu phẩy (ADMIN_ID vẫn là ID chính nếu có).
ADMIN_IDS=6138197737
BOT_USERNAME=HenDyCyberTech_BOT
BOT1_USERNAME=HenDyCyberTech_BOT
BOT2_USERNAME=HenDyCyberTech_BOT
BOT1_DISPLAY_NAME=HENDY BOT CHÍNH
BOT2_DISPLAY_NAME=HENDY BOT THỬ NGHIỆM

# PostgreSQL — lấy URL tại Connect của database đang chạy
DATABASE_URL=postgresql://USER:REPLACE_WITH_PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
DB_STARTUP_WAIT_SECONDS=120
RUN_MIGRATIONS_ON_START=true

# Mỗi webhook secret phải là chuỗi ngẫu nhiên RIÊNG BIỆT
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET_1
TELEGRAM_SECOND_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET_2
# Bank callback mặc định khóa cho đến khi có adapter xác minh chữ ký chính thức.
BANK_WEBHOOK_ENABLED=false
# Chỉ đặt BANK_WEBHOOK_SECRET sau khi cấu hình adapter ngân hàng thực tế.
BANK_WEBHOOK_SECRET=
WEBHOOK_AUTO_REGISTER=true

VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
# Nền tảng video được phép nhận link đầu vào.
MEDIA_ALLOWED_HOSTS=youtube.com,youtu.be,tiktok.com,facebook.com,fb.watch
# Chỉ bật worker khi có nhà cung cấp Vietsub thực tế hỗ trợ hợp đồng callback HMAC bên dưới.
VIDEO_PROCESSOR_URL=
VIDEO_PROCESSOR_SECRET=
VIDEO_WORKER_POLL_SECONDS=5
VIDEO_PROCESSING_STALE_MINUTES=90
GROUP_URL=https://t.me/Hendy_Support_Group
CHANNEL_URL=https://t.me/Hendy_Support_Group
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
LEGACY_SESSION_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET
WEBSITE_SESSION_TTL_SECONDS=43200

WEBSOCKET_ENABLED=true
WEBSOCKET_URL=wss://hendy-bot-tele.onrender.com/ws
WEBSOCKET_ALLOWED_ORIGINS=https://hendy-bot-cybertech.onrender.com
WEBSOCKET_MAX_CONNECTIONS=250
WEBSOCKET_BIND=127.0.0.1
WEBSOCKET_PORT=10001
