# HENDY BOT CYBERTECH — PHP 8.3 / PostgreSQL
# Local: copy this file to .env. Production: set values in Render Environment.
# This file intentionally contains NO real credentials or personal admin IDs.

APP_ENV=production
PORT=10000
APP_URL=https://hendy-bot-cybertech.onrender.com
WEBAPP_URL=https://hendy-bot-cybertech.onrender.com
ALLOWED_ORIGINS=https://hendy-bot-cybertech.onrender.com

# Bot 1: production. Bot 2: optional test bot. Use different tokens.
BOT1_TOKEN=9055868629:AAE7VSBBr0yomemjSiLBkkYJhSKJqhVyB9o
BOT2_TOKEN=9125467847:AAEcdPtmqdlXXRO579RrCBOkc7a7SyHnZw4
# Username bot is automatically fetched from Telegram getMe() using BOT1_TOKEN/BOT2_TOKEN.

# Telegram numeric user IDs. ADMIN_IDS accepts a comma-separated allowlist.
ADMIN_ID=8639286417
ADMIN_IDS=

# PostgreSQL connection string from Render/Neon. Never commit a real URL.
DATABASE_URL=postgresql://neondb_owner:npg_yO9rwiWRId1j@ep-green-water-b3fjpxk7-pooler.c-4.ap-southeast-1.aws.neon.tech/hendy-bot-tele-db?sslmode=require&channel_binding=require
# Render internal PostgreSQL URL: false. External TLS database: true.
DATABASE_SSL=true
DB_STARTUP_WAIT_SECONDS=120
RUN_MIGRATIONS_ON_START=true

# Generate two different random values (at least 32 chars):
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_SECOND_WEBHOOK_SECRET=
WEBHOOK_AUTO_REGISTER=true
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
LEGACY_SESSION_SECRET=
WEBSITE_SESSION_TTL_SECONDS=43200

# Bank callback remains disabled until a provider-specific signature adapter exists.
BANK_WEBHOOK_ENABLED=false
BANK_WEBHOOK_SECRET=

VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
GROUP_URL=
CHANNEL_URL=

MEDIA_ALLOWED_HOSTS=youtube.com,youtu.be,tiktok.com,facebook.com,fb.watch
VIDEO_PROCESSOR_URL=
VIDEO_PROCESSOR_SECRET=
VIDEO_WORKER_POLL_SECONDS=5
VIDEO_PROCESSING_STALE_MINUTES=90

WEBSOCKET_ENABLED=false
WEBSOCKET_URL=
WEBSOCKET_ALLOWED_ORIGINS=
WEBSOCKET_MAX_CONNECTIONS=250
WEBSOCKET_BIND=127.0.0.1
WEBSOCKET_PORT=10001
