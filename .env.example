# ⚙️ HENDY BOT TELE — PHP 8.3
# Sao chép thành .env khi chạy local.
# Trên Render, tạo từng biến tại Environment.
# Chỉ dùng placeholder trong file mẫu; KHÔNG commit token hoặc secret thật.

APP_ENV=production
PORT=10000
APP_URL=https://hendy-mini-app.pages.dev
WEBAPP_URLhttps://hendy-web-user.pages.dev
ALLOWED_ORIGINS=https://hendy-web-admin.pages.dev

# Telegram — tạo HAI bot riêng tại @BotFather và dùng HAI token khác nhau
BOT1_TOKEN=REPLACE_WITH_BOT1_TOKEN
BOT2_TOKEN=REPLACE_WITH_BOT2_TOKEN
# Telegram numeric user ID của tài khoản quản trị (chỉ chữ số, không dấu nháy)
ADMIN_ID=REPLACE_WITH_TELEGRAM_USER_ID
BOT_USERNAME=your_bot_username

# PostgreSQL — lấy URL tại Connect của database đang chạy
DATABASE_URL=postgresql://USER:REPLACE_WITH_PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
DB_STARTUP_WAIT_SECONDS=120
RUN_MIGRATIONS_ON_START=true

# Mỗi webhook secret phải là chuỗi ngẫu nhiên RIÊNG BIỆT
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET_1
TELEGRAM_SECOND_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET_2
# Bank callback mặc định khóa cho đến khi có adapter xác minh chữ ký chính thức.
BANK_WEBHOOK_ENABLED=false
# Chỉ đặt BANK_WEBHOOK_SECRET sau khi cấu hình adapter ngân hàng thực tế.
BANK_WEBHOOK_SECRET=
WEBHOOK_AUTO_REGISTER=true

VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
GROUP_URL=
CHANNEL_URL=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
LEGACY_SESSION_SECRET=

WEBSOCKET_URL=https://your-service.onrender.com
WEBSOCKET_BIND=0.0.0.0
WEBSOCKET_PORT=10000
