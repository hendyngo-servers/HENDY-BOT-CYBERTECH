# PostgreSQL
# Local: dùng connection string của DB local hoặc external URL với sslmode=require.
# Render: DATABASE_URL được cấp tự động qua Blueprint; DATABASE_SSL=false cho kết nối nội bộ cùng vùng.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/hendy_bot_tele?sslmode=require
DATABASE_SSL=true
PGPOOL_MAX=10

# URL công khai do Render cung cấp; để trống khi chạy local.
RENDER_EXTERNAL_URL=
WEBAPP_URL=
MINI_APP_URL=
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173

# Webhook secrets: tạo chuỗi riêng, chỉ gồm A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET
TELEGRAM_SECOND_WEBHOOK_SECRET=
BANK_WEBHOOK_SECRET=REPLACE_WITH_BANK_WEBHOOK_SECRET

# Đăng nhập website cũ (tùy chọn)
LEGACY_ACCOUNT_URL=
LEGACY_SESSION_SECRET=

# VietQR và liên kết cộng đồng (có thể cấu hình trong Dashboard)
